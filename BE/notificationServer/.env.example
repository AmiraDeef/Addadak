# Server
NODE_ENV=dev
PORT=3003

# MongoDB Atlas
DB_URL=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/Addadak_DB

# Redis (Local Docker or Memurai)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Gmail SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-gmail@gmail.com
MAIL_PASS=your-16-char-app-password
MAIL_FROM=Addadak Notifications <your-gmail@gmail.com>

# Security
# Same SECRET_KEY used in AuthServer and MetricsServer
SECRET_KEY=your-jwt-secret-key
# Random secure string for internal service-to-service auth
INTERNAL_API_KEY=your-internal-api-key

# BullMQ
BULL_MAX_ATTEMPTS=3
BULL_BACKOFF_DELAY=5000
BULL_CLEANUP_CRON=0 */6 * * *

# Wallet Service
WALLET_URL=http://localhost:3002
